[Unit]
Description=x11vnc server
After=network.target gdm.service

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :0 -forever -shared -noshm -rfbauth {{ desktop_vnc_passwd_file }} -auth /run/user/{{ desktop_uid }}/gdm/Xauthority
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
